# Copy this file to .env (never commit .env) and fill in local values.
INFRASTRUCTURE_EXISTS=yes
LITELLM_DOMAIN=litellm.example.com
OPENWEBUI_DOMAIN=webui.example.com
POSTGRES_PASSWORD=replace-with-a-long-password
LITELLM_MASTER_KEY=replace-with-a-random-master-key
LITELLM_UI_PASSWORD=replace-with-a-ui-password
LITELLM_SALT_KEY=replace-with-a-random-persistent-salt-key
OPENWEBUI_PROXY_KEY=
GIT_PUSH=no
MODEL_PROVIDER=none
OLLAMA_API_BASE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENWEBUI_URL=https://ia.kta41.local
OPENWEBUI_API_KEY=replace-with-your-openwebui-api-key
ARGOCD_VERSION=v2.13.3
CERT_MANAGER_VERSION=v1.16.2
